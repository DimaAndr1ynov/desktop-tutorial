{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),root=process.cwd(),T={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.json':'application/json','.jpg':'image/jpeg','.jpeg':'image/jpeg','.png':'image/png','.svg':'image/svg+xml','.webp':'image/webp'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const x=p.join(root,u);if(!x.startsWith(root)){r.writeHead(403);return r.end()}f.readFile(x,(e,d)=>{if(e){r.writeHead(404);return r.end('404')}r.writeHead(200,{'Content-Type':T[p.extname(x).toLowerCase()]||'application/octet-stream','Cache-Control':'no-store'});r.end(d)})}).listen(8765,'127.0.0.1',()=>console.log('serving '+root+' on 8765'))"
      ],
      "port": 8765
    }
  ]
}
